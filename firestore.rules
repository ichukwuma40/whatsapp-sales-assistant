rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document
    match /test/{docId} {
      allow read: if true;
    }

    // Reusable validation helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User's isolated Product Catalogue
      match /products/{productId} {
        allow read, write: if isOwner(userId) && isValidId(productId);
      }

      // User's isolated FAQ Knowledge Base
      match /faqs/{faqId} {
        allow read, write: if isOwner(userId) && isValidId(faqId);
      }

      // User's isolated Orders Ledger
      match /orders/{orderId} {
        allow read, write: if isOwner(userId) && isValidId(orderId);
      }

      // User's isolated Abandoned Carts Queue
      match /abandoned_carts/{cartId} {
        allow read, write: if isOwner(userId) && isValidId(cartId);
      }

      // User's isolated CRM Leads
      match /leads/{leadId} {
        allow read, write: if isOwner(userId) && isValidId(leadId);
      }
    }
  }
}
